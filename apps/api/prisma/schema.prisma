// Schema CSDL – Hệ thống quản lý NCKH sinh viên Khoa CNTT
// Supabase: DATABASE_URL qua pooler (6543, ?pgbouncer=true); DIRECT_URL cho migrate.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, unaccent]
}

enum Role {
  ADMIN
  STAFF
  LECTURER
  STUDENT
}

enum TopicStatus {
  DRAFT
  RECRUITING
  WAITING_ADVISOR
  HAS_ADVISOR
  UNDER_REVIEW
  NEEDS_REVISION
  REJECTED
  IN_PROGRESS
  WAITING_DEFENSE
  CANCELLED
  WAITING_CLOSE
  CLOSED
}

// GĐ7 FR31 (API_GD7 §2.1): nguồn đề tài – SV đề xuất / GV công bố
enum TopicOrigin {
  STUDENT
  LECTURER
}

enum MemberRole {
  LEADER
  MEMBER
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum MilestoneEval {
  PENDING
  PASSED
  NEEDS_WORK
}

enum FinalResult {
  EXCELLENT
  GOOD
  PASS
  FAIL
}

enum SimilarityLevel {
  NONE
  REVIEW
  HIGH
}

enum CheckStatus {
  OK
  ERROR
}

enum FileStatus {
  UPLOADING
  READY
}

// GĐ7 FR35–FR37 (API_GD7 §2.1): hội đồng nghiệm thu
enum CouncilRole {
  CHAIR
  SECRETARY
  MEMBER
}

enum DefenseDecision {
  PASSED
  FAILED
}

// Nguồn kết quả cuối (API_GD7 §5.5): GVHD nhập, hội đồng chốt, cán bộ sửa/đóng hết hạn
enum ResultSource {
  ADVISOR
  COUNCIL
  STAFF
}

enum ChangeType {
  TOPIC_CHANGE // FR18
  ADVISOR_CHANGE // FR19
  CANCEL // FR20
  LEAVE_GROUP // FR21
}

// ---------- Danh mục (FR04) ----------
model Faculty {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  isActive Boolean      @default(true)
  majors   Major[]
  users    User[]
  rounds   Round[]
  topics   Topic[]
  staff    StaffScope[]
  councils Council[]
}

model Major {
  id        String  @id @default(cuid())
  facultyId String
  code      String  @unique
  name      String
  isActive  Boolean @default(true)
  faculty   Faculty @relation(fields: [facultyId], references: [id])
  classes   Class[]
}

model Class {
  id       String  @id @default(cuid())
  majorId  String
  code     String  @unique
  isActive Boolean @default(true)
  major    Major   @relation(fields: [majorId], references: [id])
  students User[]
}

model Field {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  isActive Boolean @default(true)
  topics   Topic[]
}

model Round {
  id             String    @id @default(cuid())
  facultyId      String
  name           String
  academicYear   String
  regOpenAt      DateTime  @db.Timestamptz(6)
  regCloseAt     DateTime  @db.Timestamptz(6)
  reviewDeadline DateTime  @db.Timestamptz(6)
  endAt          DateTime  @db.Timestamptz(6)
  config         Json // ghi đè DEFAULT_ROUND_CONFIG
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  faculty        Faculty   @relation(fields: [facultyId], references: [id])
  topics         Topic[]
  councils       Council[]
}

// ---------- Người dùng, phiên (FR01, FR02, FR25) ----------
model User {
  id                     String               @id @default(cuid())
  code                   String               @unique
  email                  String               @unique
  fullName               String
  passwordHash           String
  role                   Role
  facultyId              String?
  classId                String?
  phone                  String?
  isLocked               Boolean              @default(false)
  mustChangePassword     Boolean              @default(true)
  failedLogins           Int                  @default(0)
  lockedUntil            DateTime?            @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  faculty                Faculty?             @relation(fields: [facultyId], references: [id])
  class                  Class?               @relation(fields: [classId], references: [id])
  refreshTokens          RefreshToken[]
  staffScopes            StaffScope[]
  memberships            TopicMember[]
  advisings              Advising[]
  notifications          Notification[]
  invitationsReceived    Invitation[]         @relation("InvitationInvitee")
  advisorRequests        AdvisorRequest[]     @relation("AdvisorRequestLecturer")
  submissionsCreated     Submission[]         @relation("SubmissionCreatedBy")
  reviewDecisions        ReviewDecision[]     @relation("ReviewDecisionDecidedBy")
  statusChanges          StatusHistory[]      @relation("StatusHistoryActor")
  milestonesCreated      Milestone[]          @relation("MilestoneCreatedBy")
  dueChangesMade         MilestoneDueChange[] @relation("DueChangeBy")
  milestoneReopens       MilestoneReopen[]    @relation("MilestoneReopenBy")
  similarityBypasses     SimilarityBypass[]   @relation("SimilarityBypassGrantedBy")
  progressUpdates        ProgressUpdate[]     @relation("ProgressAuthor")
  documentsUploaded      Document[]           @relation("DocumentUploadedBy")
  feedbacksWritten       Feedback[]           @relation("FeedbackLecturer")
  resultsCreated         ResultVersion[]      @relation("ResultCreatedBy")
  changeRequestsMade     ChangeRequest[]      @relation("ChangeRequestCreatedBy")
  changeRequestsDecided  ChangeRequest[]      @relation("ChangeRequestDecidedBy")
  changeRequestsTargeted ChangeRequest[]      @relation("ChangeRequestTarget")
  auditLogs              AuditLog[]           @relation("AuditActor")
  applications           TopicApplication[]   @relation("ApplicationStudent")
  processScores          ProcessScore[]       @relation("ProcessScoreBy")
  councilsCreated        Council[]            @relation("CouncilCreatedBy")
  councilMemberships     CouncilMember[]      @relation("CouncilMemberLecturer")
  councilAssignmentsMade CouncilAssignment[]  @relation("CouncilAssignedBy")
  councilDecisions       CouncilAssignment[]  @relation("CouncilDecidedBy")
  defenseScores          DefenseScore[]       @relation("DefenseScoreMember")
}

model StaffScope {
  userId    String
  facultyId String
  user      User    @relation(fields: [userId], references: [id])
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  @@id([userId, facultyId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  family     String
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  replacedBy String?
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([family])
}

// ---------- Đề tài (FR03, FR05, FR16, FR17) ----------
model Topic {
  id                 String              @id @default(cuid())
  code               String              @unique
  roundId            String
  facultyId          String
  fieldId            String?
  title              String              @default("")
  summary            String              @default("")
  objectives         String              @default("")
  keywords           String[]
  status             TopicStatus         @default(DRAFT)
  version            Int                 @default(0) // khóa lạc quan
  // GĐ7 FR31 (API_GD7 §2.1, §3): đề tài GV công bố; recruitSlots null khi nháp
  origin             TopicOrigin         @default(STUDENT)
  requirements       String              @default("")
  recruitSlots       Int?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  round              Round               @relation(fields: [roundId], references: [id])
  faculty            Faculty             @relation(fields: [facultyId], references: [id])
  field              Field?              @relation(fields: [fieldId], references: [id])
  members            TopicMember[]
  invitations        Invitation[]
  advisorRequests    AdvisorRequest[]
  advisings          Advising[]
  submissions        Submission[]
  milestones         Milestone[]
  progressUpdates    ProgressUpdate[]
  documents          Document[]
  feedbacks          Feedback[]
  results            ResultVersion[]
  statusHistory      StatusHistory[]
  similarityChecks   SimilarityCheck[]
  similarityBypasses SimilarityBypass[]
  changeRequests     ChangeRequest[]
  applications       TopicApplication[]
  processScores      ProcessScore[]
  councilAssignments CouncilAssignment[]

  @@index([roundId, status])
  @@index([facultyId, status])
  @@index([fieldId])
}

model TopicMember {
  id       String     @id @default(cuid())
  topicId  String
  userId   String
  role     MemberRole
  joinedAt DateTime   @default(now()) @db.Timestamptz(6)
  leftAt   DateTime?  @db.Timestamptz(6)
  topic    Topic      @relation(fields: [topicId], references: [id])
  user     User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([topicId])
}

model Invitation {
  id          String        @id @default(cuid())
  topicId     String
  inviteeId   String
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  respondedAt DateTime?     @db.Timestamptz(6)
  topic       Topic         @relation(fields: [topicId], references: [id])
  invitee     User          @relation("InvitationInvitee", fields: [inviteeId], references: [id])

  @@index([inviteeId, status])
  @@index([topicId, status])
}

model AdvisorRequest {
  id          String        @id @default(cuid())
  topicId     String
  lecturerId  String
  status      RequestStatus @default(PENDING)
  reason      String?
  remindedAt  DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  respondedAt DateTime?     @db.Timestamptz(6)
  topic       Topic         @relation(fields: [topicId], references: [id])
  lecturer    User          @relation("AdvisorRequestLecturer", fields: [lecturerId], references: [id])

  @@index([lecturerId, status])
  @@index([topicId, status])
}

// Đơn ứng tuyển đề tài GV công bố (FR32, FR33 – API_GD7 §2.2). Index application_one_active (chỉ PENDING) ở migration dc_recruitment
model TopicApplication {
  id          String        @id @default(cuid())
  topicId     String
  studentId   String
  coverLetter String
  status      RequestStatus @default(PENDING)
  reason      String?
  decidedById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  respondedAt DateTime?     @db.Timestamptz(6)
  topic       Topic         @relation(fields: [topicId], references: [id])
  student     User          @relation("ApplicationStudent", fields: [studentId], references: [id])

  @@index([topicId, status])
  @@index([studentId, status])
}

// Quan hệ hướng dẫn có thời hạn – endAt != null nghĩa là đã thay (FR19)
model Advising {
  id              String    @id @default(cuid())
  topicId         String
  lecturerId      String
  startAt         DateTime  @default(now()) @db.Timestamptz(6)
  endAt           DateTime? @db.Timestamptz(6)
  // FR19.4: cán bộ cấp quyền chỉ đọc cho GV cũ (API_GD6 §3.5)
  readOnlyGranted Boolean   @default(false)
  topic           Topic     @relation(fields: [topicId], references: [id])
  lecturer        User      @relation(fields: [lecturerId], references: [id])

  @@index([lecturerId, endAt])
}

// Snapshot bất biến của hồ sơ mỗi lần gửi (FR17)
model Submission {
  id                String           @id @default(cuid())
  topicId           String
  seq               Int
  payload           Json // title, summary, objectives, keywords, fieldId, documentIds
  createdById       String
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  similarityCheckId String?          @unique
  topic             Topic            @relation(fields: [topicId], references: [id])
  createdBy         User             @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  similarityCheck   SimilarityCheck? @relation(fields: [similarityCheckId], references: [id])
  decision          ReviewDecision?

  @@unique([topicId, seq])
}

model ReviewDecision {
  id           String     @id @default(cuid())
  submissionId String     @unique
  action       String // APPROVE | REQUEST_REVISION | REJECT
  reason       String?
  decidedById  String
  decidedAt    DateTime   @default(now()) @db.Timestamptz(6)
  submission   Submission @relation(fields: [submissionId], references: [id])
  decidedBy    User       @relation("ReviewDecisionDecidedBy", fields: [decidedById], references: [id])
}

// ---------- Thực hiện (FR09–FR12, FR22) ----------
model Milestone {
  id                String               @id @default(cuid())
  topicId           String
  order             Int
  name              String
  output            String
  dueAt             DateTime             @db.Timestamptz(6)
  required          Boolean              @default(true)
  evaluation        MilestoneEval        @default(PENDING)
  version           Int                  @default(0) // khóa lạc quan của mốc (API_GD45 §3)
  requiredRemovedAt DateTime?            @db.Timestamptz(6) // bỏ cờ bắt buộc khi chưa Đạt (m3); đếm có index thay đọc AuditLog
  createdById       String
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  topic             Topic                @relation(fields: [topicId], references: [id])
  createdBy         User                 @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  dueChanges        MilestoneDueChange[]
  reopens           MilestoneReopen[]
  documents         Document[]
  feedbacks         Feedback[]

  @@index([topicId, order])
  @@index([dueAt])
  @@index([topicId, requiredRemovedAt])
}

model MilestoneDueChange {
  id          String    @id @default(cuid())
  milestoneId String
  oldDueAt    DateTime  @db.Timestamptz(6)
  newDueAt    DateTime  @db.Timestamptz(6)
  reason      String
  changedById String
  changedAt   DateTime  @default(now()) @db.Timestamptz(6)
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  changedBy   User      @relation("DueChangeBy", fields: [changedById], references: [id])
}

// FR22 (API_GD6 §8): mỗi lần mở lại mốc đã Đạt; chỉ thêm (trigger)
model MilestoneReopen {
  id           String    @id @default(cuid())
  milestoneId  String
  reason       String
  reopenedById String
  reopenedAt   DateTime  @default(now()) @db.Timestamptz(6)
  milestone    Milestone @relation(fields: [milestoneId], references: [id])
  reopenedBy   User      @relation("MilestoneReopenBy", fields: [reopenedById], references: [id])

  @@index([milestoneId, reopenedAt])
}

model ProgressUpdate {
  id        String     @id @default(cuid())
  topicId   String
  authorId  String
  done      String
  issues    String
  nextPlan  String
  percent   Int // tự khai 0–100
  lockedAt  DateTime?  @db.Timestamptz(6) // khóa khi GVHD nhận xét
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  topic     Topic      @relation(fields: [topicId], references: [id])
  author    User       @relation("ProgressAuthor", fields: [authorId], references: [id])
  feedbacks Feedback[]

  @@index([topicId, createdAt])
}

model Document {
  id           String     @id @default(cuid())
  topicId      String
  milestoneId  String?
  stage        String // PROPOSAL | MIDTERM | FINAL | OTHER
  kind         String     @default("FILE") // FILE | LINK
  version      Int
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  publicId     String?    @unique // Cloudinary raw/authenticated
  externalUrl  String? // link GitHub/Drive cho sản phẩm lớn
  status       FileStatus @default(UPLOADING)
  isLate       Boolean    @default(false)
  uploadedById String
  uploadedAt   DateTime   @default(now()) @db.Timestamptz(6)
  topic        Topic      @relation(fields: [topicId], references: [id])
  milestone    Milestone? @relation(fields: [milestoneId], references: [id])
  uploadedBy   User       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  feedbacks    Feedback[]

  @@index([topicId, stage])
  @@index([milestoneId, version])
}

model Feedback {
  id               String          @id @default(cuid())
  topicId          String
  documentId       String?
  milestoneId      String?
  progressUpdateId String?
  evaluation       MilestoneEval?
  lecturerId       String
  content          String
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  topic            Topic           @relation(fields: [topicId], references: [id])
  document         Document?       @relation(fields: [documentId], references: [id])
  milestone        Milestone?      @relation(fields: [milestoneId], references: [id])
  progressUpdate   ProgressUpdate? @relation(fields: [progressUpdateId], references: [id])
  lecturer         User            @relation("FeedbackLecturer", fields: [lecturerId], references: [id])

  @@index([topicId, createdAt])
  @@index([progressUpdateId])
}

// Kết quả có phiên bản – sửa sai tạo bản mới (FR12, FR23)
model ResultVersion {
  id          String       @id @default(cuid())
  topicId     String
  version     Int
  result      FinalResult
  summary     String
  reason      String?
  isCurrent   Boolean      @default(true)
  source      ResultSource @default(ADVISOR) // API_GD7 §5.5
  createdById String
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  topic       Topic        @relation(fields: [topicId], references: [id])
  createdBy   User         @relation("ResultCreatedBy", fields: [createdById], references: [id])

  @@unique([topicId, version])
  @@index([topicId, isCurrent])
}

// ---------- Hội đồng nghiệm thu (FR34–FR37, API_GD7 §2.2) – SQL thô ở migration dc_council ----------
// Điểm quá trình của GVHD – chỉ thêm (trigger process_score_append_only)
model ProcessScore {
  id         String   @id @default(cuid())
  topicId    String
  lecturerId String
  score      Decimal  @db.Decimal(4, 2)
  comment    String
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  topic      Topic    @relation(fields: [topicId], references: [id])
  lecturer   User     @relation("ProcessScoreBy", fields: [lecturerId], references: [id])

  @@index([topicId, createdAt])
}

model Council {
  id          String              @id @default(cuid())
  code        String              @unique // HD-<năm học đầu>-<nnn>, sequence council_code_seq
  facultyId   String
  roundId     String
  name        String
  version     Int                 @default(0)
  createdById String
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  faculty     Faculty             @relation(fields: [facultyId], references: [id])
  round       Round               @relation(fields: [roundId], references: [id])
  createdBy   User                @relation("CouncilCreatedBy", fields: [createdById], references: [id])
  members     CouncilMember[]
  assignments CouncilAssignment[]

  @@index([roundId])
}

// Index council_one_chair/council_one_secretary (partial) ở migration
model CouncilMember {
  councilId  String
  lecturerId String
  role       CouncilRole
  council    Council     @relation(fields: [councilId], references: [id])
  lecturer   User        @relation("CouncilMemberLecturer", fields: [lecturerId], references: [id])

  @@id([councilId, lecturerId])
  @@index([lecturerId])
}

// Phân công đề tài cho hội đồng; đã chốt/hủy thì bất biến (trigger council_assignment_guarded);
// tối đa một phân công mở mỗi đề tài (council_assignment_one_open)
model CouncilAssignment {
  id           String           @id @default(cuid())
  councilId    String
  topicId      String
  assignedById String
  assignedAt   DateTime         @default(now()) @db.Timestamptz(6)
  cancelledAt  DateTime?        @db.Timestamptz(6)
  cancelReason String?
  finalScore   Decimal?         @db.Decimal(4, 2)
  decision     DefenseDecision?
  minutes      String?
  decidedById  String?
  decidedAt    DateTime?        @db.Timestamptz(6)
  council      Council          @relation(fields: [councilId], references: [id])
  topic        Topic            @relation(fields: [topicId], references: [id])
  assignedBy   User             @relation("CouncilAssignedBy", fields: [assignedById], references: [id])
  decidedBy    User?            @relation("CouncilDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  scores       DefenseScore[]

  @@index([councilId])
  @@index([topicId])
}

// Điểm bảo vệ của từng thành viên; khóa khi phân công chốt/hủy (trigger defense_score_guarded)
model DefenseScore {
  id           String            @id @default(cuid())
  assignmentId String
  memberId     String
  score        Decimal           @db.Decimal(4, 2)
  comment      String
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(6)
  assignment   CouncilAssignment @relation(fields: [assignmentId], references: [id])
  member       User              @relation("DefenseScoreMember", fields: [memberId], references: [id])

  @@unique([assignmentId, memberId])
}

// ---------- Kiểm tra tương tự (FR06) ----------
model SimilarityCheck {
  id               String           @id @default(cuid())
  topicId          String
  algorithmVersion String
  thresholds       Json
  contentHash      String
  corpusSize       Int
  level            SimilarityLevel?
  // API_GD2 §7.2 – giá trị lúc kiểm, bất biến:
  // [{topicId, code, title, academicYear, fieldName, status, titleScore, contentScore, level, matchedKeywords}]
  matches          Json
  justification    String?
  status           CheckStatus
  errorMessage     String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  topic            Topic            @relation(fields: [topicId], references: [id])
  submission       Submission?
  changeRequest    ChangeRequest?

  @@index([topicId, createdAt])
}

// G5 (API_GD6 §9): cán bộ cho phép gửi một lần khi FR06 lỗi. Chỉ thêm (trigger); hiệu lực suy ra (§9.3)
model SimilarityBypass {
  id          String   @id @default(cuid())
  topicId     String
  reason      String
  grantedById String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  topic       Topic    @relation(fields: [topicId], references: [id])
  grantedBy   User     @relation("SimilarityBypassGrantedBy", fields: [grantedById], references: [id])

  @@index([topicId, createdAt])
}

model Synonym {
  id        String @id @default(cuid())
  term      String @unique
  canonical String
}

// ---------- Yêu cầu thay đổi (FR18–FR21) ----------
model ChangeRequest {
  id                String           @id @default(cuid())
  topicId           String
  type              ChangeType
  payload           Json // bất biến (trigger change_request_guard), dạng theo loại: API_GD6 §2.1
  reason            String
  status            RequestStatus    @default(PENDING)
  createdById       String
  // Người đích phải đồng ý trước khi cán bộ duyệt (GV mới FR19, SV được thêm FR18); stage suy ra, không lưu
  targetUserId      String?
  targetAcceptedAt  DateTime?        @db.Timestamptz(6)
  similarityCheckId String?          @unique // chỉ TOPIC_CHANGE (FR18 chạy lại FR06)
  decidedById       String?
  decisionNote      String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  decidedAt         DateTime?        @db.Timestamptz(6)
  topic             Topic            @relation(fields: [topicId], references: [id])
  createdBy         User             @relation("ChangeRequestCreatedBy", fields: [createdById], references: [id])
  decidedBy         User?            @relation("ChangeRequestDecidedBy", fields: [decidedById], references: [id])
  target            User?            @relation("ChangeRequestTarget", fields: [targetUserId], references: [id])
  similarityCheck   SimilarityCheck? @relation(fields: [similarityCheckId], references: [id])

  @@index([topicId, status])
  @@index([targetUserId, status])
  @@index([status, type])
}

// ---------- Thông báo, lịch sử (FR13, FR15) ----------
model Notification {
  id             String    @id @default(cuid())
  userId         String
  type           String
  title          String
  link           String?
  dedupeKey      String
  readAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  // Hộp thư đi FR29 (API_GD7 §9.2): null = không gửi email; PENDING/SENDING/SENT/FAILED/SKIPPED
  emailStatus    String?
  emailAttempts  Int       @default(0)
  emailClaimedAt DateTime? @db.Timestamptz(6)
  emailedAt      DateTime? @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([emailStatus, createdAt])
}

model StatusHistory {
  id      String       @id @default(cuid())
  topicId String
  from    TopicStatus?
  to      TopicStatus
  action  String
  actorId String
  reason  String?
  at      DateTime     @default(now()) @db.Timestamptz(6)
  topic   Topic        @relation(fields: [topicId], references: [id])
  actor   User         @relation("StatusHistoryActor", fields: [actorId], references: [id])

  @@index([topicId, at])
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  // RESTRICT: không xóa cứng được người đã thực hiện thao tác (FR15 "ghi ai"); ghi AuditLog cho người vừa bị xóa thì lỗi (review TASK-USER-DELETE m4)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
}
