    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17",
