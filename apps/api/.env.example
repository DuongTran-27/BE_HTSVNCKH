NODE_ENV=development
PORT=4000
# Supabase: Settings > Database > Connection string
# Runtime qua pooler (transaction mode, cổng 6543)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrate qua session pooler (cổng 5432) – Render không hỗ trợ IPv6 của kết nối trực tiếp
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
JWT_ACCESS_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Chỉ `true`/`false`; không dùng thì bỏ hẳn dòng, không để rỗng (rỗng làm server không khởi động)
ENABLE_SWAGGER=true
CLOUDINARY_URL="cloudinary://<key>:<secret>@<cloud>"
CRON_SECRET="chuoi-bi-mat-cho-github-actions-goi-nhac-han"
# Bí mật chung với Vercel (middleware gắn header x-nckh-origin); >= 32 ký tự. Bỏ trống khi chạy cục bộ (T706, VAN_HANH §6)
# ORIGIN_SECRET="chuoi-ngau-nhien-toi-thieu-32-ky-tu-trung-voi-vercel"
# Đăng nhập Google (FR28) – tùy chọn: thiếu MỘT trong 4 biến thì nút Google ẩn, /api/auth/google/* trả 404.
# Tạo OAuth client "Web application" ở Google Cloud Console (con người làm). Redirect URI phải đăng ký đúng:
#   <PUBLIC_APP_URL>/api/auth/google/callback   (vd. http://localhost:5173/api/auth/google/callback khi chạy cục bộ)
# GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="<client-secret>"
# Tên miền email trường, cách nhau bằng dấu phẩy, chữ thường (email phải đúng tên miền `hd` của Google Workspace)
# GOOGLE_ALLOWED_DOMAINS="vanlanguni.vn,vlu.edu.vn"
# URL trang web (không có / ở cuối; production bắt buộc https)
# PUBLIC_APP_URL="http://localhost:5173"
