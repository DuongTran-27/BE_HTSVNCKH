{
  "name": "nckh-cntt",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js vitest.config.js .prettierrc.json .github",
    "db:test:up": "node apps/api/scripts/db-test.js up",
    "db:test:reset": "npm run db:test:reset -w @nckh/api",
    "db:test:down": "node apps/api/scripts/db-test.js down",
    "db:dev:up": "node apps/api/scripts/db-dev.js up",
    "db:dev:down": "node apps/api/scripts/db-dev.js down",
    "dev:api": "npm run dev -w @nckh/api",
    "dev:web": "npm run dev -w @nckh/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
