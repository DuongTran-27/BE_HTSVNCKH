{
  "name": "@nckh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "shared"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check eslint.config.js vitest.config.js .prettierrc.json .github",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:test:up": "node scripts/db-test.js up",
    "db:test:reset": "node scripts/reset-test-db.js",
    "db:test:down": "node scripts/db-test.js down",
    "db:dev:up": "node scripts/db-dev.js up",
    "db:dev:down": "node scripts/db-dev.js down",
    "demo:people": "node --env-file-if-exists=.env scripts/demo-people.js",
    "demo:stats": "node --env-file-if-exists=.env scripts/demo-stats.js",
    "perf": "node tests/perf/run-perf.js",
    "eval:fr06": "node tests/fr06-eval/run.js"
  },
  "dependencies": {
    "@nckh/shared": "0.1.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "google-auth-library": "10.9.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "10.6.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.12",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
